{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/shop/",
      "destination": "/shop.html"
    },
    {
      "source": "/eldorado",
      "destination": "https://el-dorado-xi.vercel.app/eldorado"
    },
    {
      "source": "/eldorado/:path*",
      "destination": "https://el-dorado-xi.vercel.app/eldorado/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/shop.html",
      "destination": "/shop",
      "permanent": true
    }
  ]
}
